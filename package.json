{
  "name": "skylit",
  "version": "2.17.2",
  "private": true,
  "scripts": {
    "build": "node scripts/build_frontend.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:react": "node scripts/check_react_frontend.cjs && node scripts/check_react_recovery.cjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.25.0",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "typescript": "5.7.3"
  }
}
